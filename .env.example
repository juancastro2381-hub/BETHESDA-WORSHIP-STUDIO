# ==============================================================================
# Bethesda Worship Studio — Root Environment Configuration Template
# Organization: Iglesia Cristiana Bethesda — Madrid, Cundinamarca, Colombia
# ==============================================================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# REQUIRED: Provide your local or server PostgreSQL credentials.
# Do NOT commit actual passwords or connection strings with credentials to version control.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/bethesda_worship_dev
TEST_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/bethesda_worship_test

# Client / CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Phase 2B Security & Authentication Secrets (Required: min 32 characters / 256 bits)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
COOKIE_SECRET=replace_with_another_secure_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Audio Storage Path
AUDIO_STORAGE_PATH=storage/audio
MAX_AUDIO_FILE_SIZE_BYTES=52428800
