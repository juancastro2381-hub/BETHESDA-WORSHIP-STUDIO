# Environment and Secrets
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build Outputs
dist/
backend/dist/
frontend/dist/
*.tsbuildinfo

# OS & Logs
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Runtime Storage Artifacts (Generated during tests and ingestion)
backend/storage/sources/*
!backend/storage/sources/.gitkeep
backend/storage/audio/*
!backend/storage/audio/.gitkeep
backend/storage/documents/*
!backend/storage/documents/.gitkeep
backend/storage/outputs/*
!backend/storage/outputs/.gitkeep
/storage/

# Python Virtual Environments & Worker Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
workers/**/.venv/
workers/**/venv/
workers/**/__pycache__/
workers/**/models/
workers/**/cache/
workers/**/temp/



